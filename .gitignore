# Root gitignore for Apteka Platform

# Backend ignores
backend/vendor/
backend/node_modules/
backend/public/build
backend/public/hot
backend/public/storage
backend/storage/*.key
backend/storage/framework/cache/*
backend/storage/framework/sessions/*
backend/storage/framework/views/*
backend/storage/logs/*
backend/.env
backend/.env.backup
backend/.env.production
backend/.phpunit.result.cache
backend/database/database.sqlite
backend/database/database.sqlite-journal

# Frontend ignores
frontend/node_modules/
frontend/dist/
frontend/dist-ssr/
frontend/.env.local
frontend/.env.*.local
frontend/*.local

# OS / Editor files
.DS_Store
Thumbs.db
.idea/
.vscode/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
